# ZyzDisplay production configuration
ZYZ_USER=zyztem
NETWORK_IFACE=wlan1
MIRACAST_IFACE=wlan0
DISPLAY_NAME=ZyzDisplay
DRM_CONNECTOR_ID=35
DRM_CONNECTOR_NAME=HDMI-A-1
DRM_MODE=1920x1080@60
AUDIO_DEVICE=plughw:1,0
SPOTIFY_STATUS_URL=http://127.0.0.1:3678/status

# Wallhaven wallpaper rotation
WALLHAVEN_ENABLED=1
WALLHAVEN_INTERVAL=300
WALLHAVEN_BATCH_REFRESH=7200
WALLHAVEN_QUERY="wildlife -cgi -3d -fantasy,nature landscape -cgi -3d,forest mountains -cgi,castle palace -fantasy -cgi,temple pyramid ruins -cgi"
WALLHAVEN_CATEGORIES=100
WALLHAVEN_PURITY=100
WALLHAVEN_RESOLUTION=1920x1080
WALLHAVEN_RATIOS=16x9

# Open-Meteo NOAA NBM weather
WEATHER_ENABLED=1
WEATHER_LOCATION="Newberry, Florida"
WEATHER_UNITS=u
WEATHER_REFRESH=900

# Google Calendar secret iCal URL (comma-separated URLs allowed)
CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/jwwoods663%40outlook.com/private-946de0945176f312dc2f5284637fd569/basic.ics
CALENDAR_REFRESH=900

# Phone notification mirror (token lives only in /etc/zyzdisplay/zyzdisplay.env)
NTFY_ENABLED=1
NTFY_URL=https://ntfy.mniz.dev
NTFY_TOPIC=BLll6HGzJA0P9U4U
NTFY_TOKEN=
