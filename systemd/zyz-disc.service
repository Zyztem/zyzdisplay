[Unit]
StartLimitIntervalSec=0
Description=ZyzDisplay optical disc player
After=sound.target zyzdisplay-dashboard.service

[Service]
Type=simple
EnvironmentFile=/etc/zyzdisplay/zyzdisplay.env
ExecStart=/usr/bin/python3 /usr/local/libexec/zyz-disc
RuntimeDirectory=zyzdisplay
RuntimeDirectoryMode=0755
KillMode=mixed
TimeoutStopSec=6
SuccessExitStatus=0 1
