#!/usr/bin/env python3
"""Watches all keyboards for Ctrl+Alt+Esc and drops the DRM kiosk to a text console.

The kiosk (Cog) renders directly to DRM/KMS with no window manager, so there is
normally no way back to a login prompt from the keyboard alone. This runs as
its own root service, independent of Cog and the dashboard, so it still works
if the kiosk or the web page it's showing is hung or crashed.
"""
import glob
import select
import subprocess
import sys
import time

import evdev
from evdev import ecodes

CTRL_KEYS = {ecodes.KEY_LEFTCTRL, ecodes.KEY_RIGHTCTRL}
ALT_KEYS = {ecodes.KEY_LEFTALT, ecodes.KEY_RIGHTALT}
ESC_KEY = ecodes.KEY_ESC
RESCAN_INTERVAL = 5.0
EXIT_MESSAGE = (
    "\r\n"
    "ZyzDisplay kiosk stopped for terminal access.\r\n"
    "Run 'sudo systemctl start zyzdisplay-kiosk' to resume the display.\r\n"
    "\r\n"
)


def open_keyboards(known):
    devices = {}
    for path in glob.glob("/dev/input/event*"):
        if path in known:
            continue
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        caps = dev.capabilities().get(ecodes.EV_KEY, [])
        if ESC_KEY in caps and CTRL_KEYS & set(caps):
            devices[path] = dev
        else:
            dev.close()
    return devices


def exit_to_terminal():
    print("Ctrl+Alt+Esc detected, stopping zyzdisplay-kiosk.service", file=sys.stderr)
    subprocess.run(["systemctl", "stop", "zyzdisplay-kiosk.service"], check=False)
    for tty in ("/dev/tty1", "/dev/console"):
        try:
            with open(tty, "w") as f:
                f.write(EXIT_MESSAGE)
            break
        except OSError:
            continue


def main():
    devices = {}
    held = set()
    armed = True
    last_scan = 0.0
    while True:
        now = time.monotonic()
        if now - last_scan > RESCAN_INTERVAL:
            devices.update(open_keyboards(devices))
            last_scan = now
        if not devices:
            time.sleep(1)
            continue
        try:
            ready, _, _ = select.select(list(devices.values()), [], [], 1.0)
        except (OSError, ValueError):
            devices = open_keyboards({})
            continue
        for dev in ready:
            try:
                events = list(dev.read())
            except OSError:
                devices.pop(dev.path, None)
                continue
            for event in events:
                if event.type != ecodes.EV_KEY:
                    continue
                if event.value == 1:
                    held.add(event.code)
                elif event.value == 0:
                    held.discard(event.code)
                if event.code == ESC_KEY:
                    if event.value == 1 and armed and held & CTRL_KEYS and held & ALT_KEYS:
                        armed = False
                        exit_to_terminal()
                    elif event.value == 0:
                        armed = True


if __name__ == "__main__":
    main()
