#!/usr/bin/env python3
"""Play audio CDs on the dashboard now-playing card, and video discs full-screen."""

import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

RUN = Path("/run/zyzdisplay")
STATUS_PATH = RUN / "nowplaying.json"
COVER_PATH = RUN / "cover.jpg"
SOCK_PATH = RUN / "mpv.sock"
DEVICE = os.environ.get("DISC_DEVICE", "/dev/sr0")
AUDIO_DEVICE = os.environ.get("AUDIO_DEVICE", "plughw:1,0")
TAKE = os.environ.get("ZYZ_DISPLAY_TAKE", "/usr/local/libexec/zyz-display-take")
UA = "ZyzDisplay/1.0 (optical disc metadata)"

mpv_proc = None
took_video = False
took_audio = False
cleaned = False


def log(msg):
    print(f"zyz-disc: {msg}", flush=True)


def run(*cmd, timeout=8):
    try:
        result = subprocess.run(
            cmd, check=False, capture_output=True, text=True, timeout=timeout
        )
        return result.returncode, (result.stdout or "").strip(), (result.stderr or "").strip()
    except Exception as exc:
        return 1, "", str(exc)


def process_running(name):
    return subprocess.run(
        ["pgrep", "-x", name], check=False, capture_output=True
    ).returncode == 0


def udev_props(dev):
    code, out, _ = run("udevadm", "info", "--query=property", f"--name={dev}")
    props = {}
    if code != 0:
        return props
    for line in out.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        props[key] = value
    return props


def wait_for_media(dev, seconds=15):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if not Path(dev).exists():
            time.sleep(0.4)
            continue
        props = udev_props(dev)
        if props.get("ID_CDROM_MEDIA") == "1" or props.get("ID_CDROM_MEDIA_STATE") == "complete":
            return props
        if int(props.get("ID_CDROM_MEDIA_TRACK_COUNT_AUDIO") or 0) > 0:
            return props
        if props.get("ID_CDROM_MEDIA_DVD") == "1" or props.get("ID_FS_TYPE"):
            return props
        time.sleep(0.5)
    return {}


def classify(dev, props):
    audio_tracks = int(props.get("ID_CDROM_MEDIA_TRACK_COUNT_AUDIO") or 0)
    if audio_tracks > 0:
        return "audio"
    if props.get("ID_CDROM_MEDIA_DVD") == "1" or props.get("ID_CDROM_MEDIA_BD") == "1":
        return "dvd"
    fs = (props.get("ID_FS_TYPE") or "").lower()
    if fs in ("iso9660", "udf"):
        return "data"
    code, _, _ = run("cd-discid", dev, timeout=4)
    if code == 0:
        return "audio"
    return "unknown"


def write_status(payload):
    RUN.mkdir(parents=True, exist_ok=True)
    tmp = STATUS_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload), encoding="utf-8")
    tmp.chmod(0o644)
    tmp.replace(STATUS_PATH)
    try:
        STATUS_PATH.chmod(0o644)
    except OSError:
        pass


def clear_status():
    for path in (STATUS_PATH, COVER_PATH, SOCK_PATH):
        try:
            path.unlink()
        except FileNotFoundError:
            pass


def http_json(url, timeout=8):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return json.loads(res.read().decode("utf-8"))


def http_bytes(url, timeout=8):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return res.read()


def tracks_from_discid(out):
    parts = out.split()
    if len(parts) < 3:
        return []
    try:
        ntracks = int(parts[1])
    except ValueError:
        return []
    frames = []
    for token in parts[2:2 + ntracks]:
        try:
            frames.append(int(token))
        except ValueError:
            return []
    try:
        total_s = float(parts[2 + ntracks])
    except (IndexError, ValueError):
        total_s = 0
    tracks = []
    for idx, start in enumerate(frames):
        if idx + 1 < len(frames):
            length_ms = int(round((frames[idx + 1] - start) / 75 * 1000))
        elif total_s:
            length_ms = int(round((total_s - start / 75) * 1000))
        else:
            length_ms = 0
        tracks.append({
            "name": f"Track {idx + 1}",
            "artist": "Unknown artist",
            "length_ms": max(0, length_ms),
        })
    return tracks


def lookup_cd(dev, meta):
    code, out, _ = run("cd-discid", dev, timeout=5)
    if code != 0 or not out:
        return
    fallback = tracks_from_discid(out)
    if fallback:
        meta["tracks"] = fallback
    discid = out.split()[0]
    url = (
        "https://musicbrainz.org/ws/2/discid/"
        + urllib.parse.quote(discid)
        + "?inc=artists+recordings+release-groups&fmt=json"
    )
    try:
        data = http_json(url)
    except Exception as exc:
        log(f"musicbrainz lookup failed: {exc}")
        return

    releases = data.get("releases") or []
    if not releases:
        log(f"musicbrainz: no release for {discid}")
        return
    release = releases[0]
    album = release.get("title") or meta.get("album") or "Audio CD"
    ac = (release.get("artist-credit") or [{}])[0]
    artist = ac.get("name") or (ac.get("artist") or {}).get("name") or "Unknown artist"
    mbid = release.get("id") or ""
    media = (release.get("media") or [{}])[0]
    tracks = []
    for idx, rec in enumerate(media.get("tracks") or [], start=1):
        rec_artist = artist
        credit = rec.get("artist-credit") or []
        if credit:
            rec_artist = credit[0].get("name") or rec_artist
        tracks.append({
            "name": rec.get("title") or f"Track {idx}",
            "artist": rec_artist,
            "length_ms": int(float(rec.get("length") or 0)),
        })
    meta["album"] = album
    meta["artist"] = artist
    if tracks:
        meta["tracks"] = tracks
    if mbid:
        try:
            body = http_bytes(f"https://coverartarchive.org/release/{mbid}/front-500")
            if body:
                COVER_PATH.write_bytes(body)
                COVER_PATH.chmod(0o644)
                meta["cover"] = f"/disc-cover?t={int(time.time())}"
        except Exception as exc:
            log(f"cover art skipped: {exc}")


def take(audio_only=False):
    global took_audio, took_video
    cmd = [TAKE]
    if audio_only:
        cmd.append("--audio")
        took_audio = True
    else:
        took_video = True
        took_audio = True
    subprocess.run(cmd, check=False, timeout=8)


def restore():
    global took_audio, took_video
    subprocess.run(
        ["systemctl", "reset-failed", "zyzdisplay-kiosk.service"],
        check=False, capture_output=True,
    )
    if took_video:
        subprocess.run(
            ["systemctl", "start", "--no-block",
             "zyzdisplay-kiosk.service", "uxplay.service",
             "zyz-bluetooth.service", "go-librespot.service"],
            check=False,
        )
    elif took_audio:
        subprocess.run(
            ["systemctl", "start", "--no-block",
             "zyz-bluetooth.service", "go-librespot.service"],
            check=False,
        )
    took_audio = False
    took_video = False


def mpv_cmd(*args, ipc=None):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(1.0)
    sock.connect(str(ipc or SOCK_PATH))
    payload = json.dumps({"command": list(args)}) + "\n"
    sock.sendall(payload.encode("utf-8"))
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
    sock.close()
    line = buf.split(b"\n", 1)[0]
    if not line:
        return None
    return json.loads(line.decode("utf-8"))


def mpv_get(name):
    try:
        res = mpv_cmd("get_property", name)
        if res and res.get("error") == "success":
            return res.get("data")
    except Exception:
        return None
    return None


def start_mpv(args):
    global mpv_proc
    try:
        SOCK_PATH.unlink()
    except FileNotFoundError:
        pass
    cmd = [
        "mpv",
        "--no-terminal",
        "--msg-level=all=error,cdda=info,file=info",
        f"--input-ipc-server={SOCK_PATH}",
        f"--audio-device=alsa/{AUDIO_DEVICE}",
        "--ao=alsa",
        "--volume=75",
        "--gapless-audio=yes",
        *args,
    ]
    log("running: " + " ".join(cmd))
    mpv_proc = subprocess.Popen(cmd)
    for _ in range(50):
        if SOCK_PATH.exists():
            break
        if mpv_proc.poll() is not None:
            break
        time.sleep(0.1)
    return mpv_proc


def stop_mpv():
    global mpv_proc
    if not mpv_proc:
        return
    if mpv_proc.poll() is None:
        mpv_proc.send_signal(signal.SIGTERM)
        try:
            mpv_proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            mpv_proc.kill()
    mpv_proc = None


def audio_status(meta, pos_s, dur_s, paused, index, buffering=False, volume=75):
    album = meta.get("album") or "Audio CD"
    artist = meta.get("artist") or "Unknown artist"
    tracks = meta.get("tracks") or []
    cover = meta.get("cover") or ""
    if tracks and 0 <= index < len(tracks):
        item = tracks[index]
        track = {
            "name": item["name"],
            "artist_names": [item["artist"]],
            "album_name": album,
            "album_cover_url": cover,
            "position": int(max(0, pos_s) * 1000),
            "duration": item["length_ms"] or int(max(0, dur_s) * 1000),
        }
    else:
        track = {
            "name": f"Track {index + 1}" if index >= 0 else "Audio CD",
            "artist_names": [artist],
            "album_name": album,
            "album_cover_url": cover,
            "position": int(max(0, pos_s) * 1000),
            "duration": int(max(0, dur_s) * 1000),
        }
    return {
        "source": "cd",
        "stopped": False,
        "paused": paused,
        "buffering": buffering,
        "volume": int(volume),
        "volume_steps": 100,
        "track": track,
    }


def play_audio(dev):
    meta = {
        "album": "Audio CD",
        "artist": "Unknown artist",
        "tracks": [],
        "cover": "",
    }
    write_status(audio_status(meta, 0, 0, True, 0, True))
    take(audio_only=True)
    time.sleep(0.2)
    start_mpv([
        "--no-video",
        "--vo=null",
        f"--cdda-device={dev}",
        "cdda://",
    ])
    worker = threading.Thread(target=lookup_cd, args=(dev, meta), daemon=True)
    worker.start()
    while mpv_proc and mpv_proc.poll() is None:
        paused = bool(mpv_get("pause"))
        pos = float(mpv_get("playback-time") or 0)
        dur = float(mpv_get("duration") or 0)
        index = int(mpv_get("playlist-pos") or 0)
        volume = mpv_get("volume")
        if volume is None:
            volume = 75
        write_status(audio_status(meta, pos, dur, paused, index, volume=volume))
        time.sleep(0.8)
    worker.join(timeout=0.1)


def find_video_file(root):
    exts = {".mkv", ".mp4", ".avi", ".m4v", ".mpg", ".mpeg", ".vob", ".ts"}
    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        lower = {name.lower() for name in dirnames}
        if "video_ts" in lower:
            return "dvd"
        for name in filenames:
            if Path(name).suffix.lower() in exts:
                path = Path(dirpath) / name
                try:
                    found.append((path.stat().st_size, path))
                except OSError:
                    continue
    if not found:
        return None
    found.sort(reverse=True)
    return str(found[0][1])


def play_video(dev, kind):
    take(audio_only=False)
    time.sleep(0.15)
    args = [
        "--fs",
        "--vo=gpu",
        "--gpu-context=drm",
        "--hwdec=auto-safe",
        "--profile=fast",
    ]
    if kind == "dvd":
        args += [f"--dvd-device={dev}", "dvd://"]
    else:
        mount = Path("/run/zyzdisplay/disc")
        mount.mkdir(parents=True, exist_ok=True)
        subprocess.run(["umount", "-l", str(mount)], check=False, capture_output=True)
        code, _, err = run("mount", "-o", "ro", dev, str(mount), timeout=10)
        if code != 0:
            log(f"mount failed: {err}")
            args += [f"--dvd-device={dev}", "dvd://"]
        else:
            target = find_video_file(mount)
            if target == "dvd":
                args += [f"--dvd-device={dev}", "dvd://"]
            elif target:
                args.append(target)
            else:
                log("no video files on data disc")
                subprocess.run(["umount", "-l", str(mount)], check=False, capture_output=True)
                return
    start_mpv(args)
    if mpv_proc:
        mpv_proc.wait()
    subprocess.run(["umount", "-l", "/run/zyzdisplay/disc"], check=False, capture_output=True)


def cleanup(*_args):
    global cleaned
    if cleaned:
        return
    cleaned = True
    stop_mpv()
    clear_status()
    restore()
    subprocess.run(["umount", "-l", "/run/zyzdisplay/disc"], check=False, capture_output=True)


def main():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    os.umask(0o022)
    RUN.mkdir(parents=True, exist_ok=True)
    if process_running("gst-launch-1.0"):
        log("hdmi busy with miracast, skipping disc")
        return 0

    dev = DEVICE
    if not Path(dev).exists():
        for path in Path("/dev").glob("sr*"):
            dev = str(path)
            break
    if not Path(dev).exists():
        log("no optical drive")
        return 0

    props = wait_for_media(dev)
    if not props:
        log("no disc")
        return 0

    kind = classify(dev, props)
    log(f"{dev} classified as {kind}")
    try:
        if kind == "audio":
            play_audio(dev)
        elif kind in ("dvd", "data"):
            play_video(dev, kind)
        else:
            log("unsupported disc")
    finally:
        cleanup()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        log(f"failed: {exc}")
        cleanup()
        sys.exit(1)
