#!/bin/bash
set -euo pipefail

source /etc/zyzdisplay/zyzdisplay.env

URL="http://127.0.0.1:8080/"

for _ in $(seq 1 60); do
    if curl -fsS "$URL" >/dev/null 2>&1; then
        break
    fi
    sleep 0.2
done

# cage is a wlroots-based kiosk compositor: one fullscreen client, no
# decorations, exits (and gets restarted by systemd) if that client exits.
# wlroots' DRM backend handles plane/rotation/modesetting far more robustly
# across hardware than Cog's own bare --platform=drm backend did, which is
# what was producing corrupted output on Pi 5's KMS driver.
# -s allows VT switching (Ctrl+Alt+F<n>) out of the compositor as a second,
# independent escape path alongside zyz-kiosk-escape.service.
exec /usr/bin/cage -s -- /usr/bin/cog --platform=wl --bg-color=black \
    --webprocess-failure=restart \
    --web-mem-limit=128 \
    --web-check-interval=20 \
    --net-mem-limit=24 \
    --net-check-interval=30 \
    --enable-2d-canvas-acceleration=false \
    --enable-webgl=false \
    --enable-media=false \
    --enable-webaudio=false \
    --enable-media-stream=false \
    --enable-mediasource=false \
    --enable-webrtc=false \
    --enable-encrypted-media=false \
    --enable-smooth-scrolling=false \
    --enable-page-cache=false \
    --enable-html5-database=false \
    --enable-html5-local-storage=false \
    --enable-offline-web-application-cache=false \
    --enable-dns-prefetching=false \
    "$URL"
